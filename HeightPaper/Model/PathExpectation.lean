module

public import HeightPaper.Model.PathMeasure
public import HeightPaper.Probability.FinitePMF
public import Mathlib.MeasureTheory.Function.ConditionalExpectation.Basic

/-!
# Conditional expectations of the actual epidemic path kernel

The sigma algebra generated by the entire preceding history gives the exact
one-step conditional expectation. No independence or Markov property is
postulated: the result follows from the joint finite history PMF.
-/

@[expose] public section

open MeasureTheory
open scoped NNReal ENNReal

namespace HeightPaper.Model

theorem finite_support_step (rate : ℝ≥0) (s : State) : (step rate s).support.Finite := by
  by_cases h : s.active.Nonempty
  · rw [step, dite_eq_left h]
    apply FinitePMF.finite_support_bind _ _ (Set.toFinite _)
    intro v _
    exact FinitePMF.finite_support_map _ (Set.toFinite _) _
  · rw [step, dite_eq_right h, PMF.support_pure]
    exact Set.finite_singleton s

theorem finite_support_pathLaw (rate : ℝ≥0) (n steps : ℕ) :
    (pathLaw rate n steps).support.Finite := by
  induction steps with
  | zero => rw [pathLaw, PMF.support_pure]; exact Set.finite_singleton _
  | succ steps ih =>
      rw [pathLaw]
      exact FinitePMF.finite_support_bind _ _ ih fun p _ ↦
        FinitePMF.finite_support_map _ (finite_support_step rate p.last) _

theorem integrable_pathMeasure (rate : ℝ≥0) (n steps : ℕ) (f : FinitePath steps → ℝ) :
    Integrable f (pathMeasure rate n steps) :=
  FinitePMF.integrable_of_finite_support _ (finite_support_pathLaw rate n steps) f

/-- Exact iterated expectation for the next state, retaining the whole past. -/
theorem pathMeasure_integral_succ (rate : ℝ≥0) (n steps : ℕ)
    (f : FinitePath (steps + 1) → ℝ) :
    ∫ p, f p ∂pathMeasure rate n (steps + 1) =
      ∫ p, ∫ s, f (p.append s) ∂(step rate p.last).toMeasure ∂pathMeasure rate n steps := by
  rw [pathMeasure, pathLaw]
  rw [FinitePMF.integral_bind_of_finite_support _ _ (FinitePath.measurable _)
    (finite_support_pathLaw rate n steps)
    (fun p _ ↦ FinitePMF.finite_support_map _ (finite_support_step rate p.last) _) f]
  apply integral_congr_ae
  filter_upwards [] with p
  rw [← PMF.toMeasure_map _ _ (measurable_state _),
    integral_map_of_stronglyMeasurable (measurable_state _) (FinitePath.measurable f).stronglyMeasurable]

/-- The information in all states before the last transition. -/
@[instance_reducible] def prefixSigma (steps : ℕ) : MeasurableSpace (FinitePath (steps + 1)) :=
  (inferInstance : MeasurableSpace (FinitePath steps)).comap FinitePath.prefixPath

theorem prefixSigma_le (steps : ℕ) :
    prefixSigma steps ≤ (inferInstance : MeasurableSpace (FinitePath (steps + 1))) := le_top

/-- A function of the prefix is measurable for the prefix sigma algebra. -/
theorem measurable_prefix_comp (steps : ℕ) (g : FinitePath steps → ℝ) :
    Measurable[prefixSigma steps] (fun p ↦ g p.prefixPath) := by
  intro s hs
  exact ⟨g ⁻¹' s, (FinitePath.measurable g) hs, rfl⟩

/-- Conditional expectation given the entire preceding path is exactly the
integral against the epidemic transition from its last state. -/
theorem condExp_pathMeasure_succ (rate : ℝ≥0) (n steps : ℕ)
    (f : FinitePath (steps + 1) → ℝ) :
    (fun p ↦ ∫ s, f (p.prefixPath.append s) ∂(step rate p.prefixPath.last).toMeasure)
      =ᵐ[pathMeasure rate n (steps + 1)]
        (pathMeasure rate n (steps + 1))[f | prefixSigma steps] := by
  let g : FinitePath steps → ℝ := fun p ↦ ∫ s, f (p.append s) ∂(step rate p.last).toMeasure
  apply ae_eq_condExp_of_forall_setIntegral_eq (prefixSigma_le steps)
    (integrable_pathMeasure rate n (steps + 1) f)
  · intro A _ _
    exact (integrable_pathMeasure rate n (steps + 1) (fun p ↦ g p.prefixPath)).integrableOn
  · intro A hA _
    obtain ⟨B, _, rfl⟩ := hA
    rw [← integral_indicator (show MeasurableSet (FinitePath.prefixPath ⁻¹' B) from trivial),
      ← integral_indicator (show MeasurableSet (FinitePath.prefixPath ⁻¹' B) from trivial),
      pathMeasure_integral_succ, pathMeasure_integral_succ]
    apply integral_congr_ae
    filter_upwards [] with p
    by_cases hp : p ∈ B
    · simp only [Set.indicator, Set.mem_preimage, FinitePath.prefix_append, hp, ↓reduceIte]
      simp
    · simp only [Set.indicator, Set.mem_preimage, FinitePath.prefix_append, hp, ↓reduceIte,
        integral_zero]
  · exact (measurable_prefix_comp steps g).stronglyMeasurable.aestronglyMeasurable

/-- Specialization to a state observable gives the usual Markov conditional
expectation, with no extra Markov assumption. -/
theorem condExp_last_of_kernel (rate : ℝ≥0) (n steps : ℕ) (F : State → ℝ) :
    (fun p ↦ ∫ s, F s ∂(step rate p.prefixPath.last).toMeasure)
      =ᵐ[pathMeasure rate n (steps + 1)]
        (pathMeasure rate n (steps + 1))[(fun p ↦ F p.last) | prefixSigma steps] := by
  simpa only [FinitePath.append_last] using condExp_pathMeasure_succ rate n steps (fun p ↦ F p.last)

theorem FinitePath.prefix_last_eq_eval {steps : ℕ} (p : FinitePath (steps + 1)) :
    p.prefixPath.last = p.eval steps := by
  calc
    p.prefixPath.last = p.prefixPath.eval steps := (FinitePath.eval_last _).symm
    _ = (p.prefixPath.append p.last).eval steps :=
      (FinitePath.append_eval_of_le p.prefixPath p.last le_rfl).symm
    _ = p.eval steps := congrArg (fun q ↦ q.eval steps) p.append_prefix_last

/-- A verified zero-drift identity on every reachable state is promoted to an
actual conditional-expectation identity given the full preceding history. -/
theorem condExp_last_of_zero_drift (rate : ℝ≥0) (n steps : ℕ) (F : State → ℝ)
    (hF : ∀ s ∈ (evolve rate n steps).support,
      (∫ t, F t ∂(step rate s).toMeasure) = F s) :
    (fun p ↦ F p.prefixPath.last) =ᵐ[pathMeasure rate n (steps + 1)]
      (pathMeasure rate n (steps + 1))[(fun p ↦ F p.last) | prefixSigma steps] := by
  refine (Filter.EventuallyEq.trans ?_ (condExp_last_of_kernel rate n steps F))
  filter_upwards [ae_supportedPath rate n (steps + 1)] with p hp
  apply (hF _ ?_).symm
  rw [FinitePath.prefix_last_eq_eval]
  exact hp.mem_evolve (by omega)

end HeightPaper.Model
