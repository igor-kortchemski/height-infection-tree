module

public import HeightPaper.Model.Paths

/-!
# The joint law of finite epidemic histories

The finite history law records every state generated by the actual SIR kernel.
Its support consists exactly of supported paths and its coordinate marginals
are the previously defined `evolve` laws. Thus pathwise facts about extinction
or outgrowths can be used under an actual probability measure.
-/

@[expose] public section

open MeasureTheory
open scoped NNReal ENNReal

namespace HeightPaper.Model

/-- A history including the initial state and `steps` transitions. -/
structure FinitePath (steps : ℕ) where
  state : Fin (steps + 1) → State

namespace FinitePath

instance (steps : ℕ) : MeasurableSpace (FinitePath steps) := ⊤
instance (steps : ℕ) : MeasurableSingletonClass (FinitePath steps) where
  measurableSet_singleton _ := trivial

theorem measurable {steps : ℕ} {α : Type*} [MeasurableSpace α]
    (f : FinitePath steps → α) : Measurable f := fun _ _ ↦ trivial

@[ext] theorem ext {steps : ℕ} {p q : FinitePath steps}
    (h : ∀ i, p.state i = q.state i) : p = q := by
  cases p
  cases q
  congr
  exact funext h

/-- Evaluate beyond the recorded horizon by keeping the terminal state fixed. -/
def eval {steps : ℕ} (p : FinitePath steps) (k : ℕ) : State :=
  p.state ⟨min k steps, Nat.lt_succ_of_le (Nat.min_le_right k steps)⟩

def last {steps : ℕ} (p : FinitePath steps) : State := p.state (Fin.last steps)

@[simp] theorem eval_last {steps : ℕ} (p : FinitePath steps) : p.eval steps = p.last := by
  unfold eval last
  congr 1
  exact Fin.ext (by simp)

def append {steps : ℕ} (p : FinitePath steps) (s : State) : FinitePath (steps + 1) :=
  ⟨Fin.lastCases s p.state⟩

def prefixPath {steps : ℕ} (p : FinitePath (steps + 1)) : FinitePath steps :=
  ⟨fun i ↦ p.state i.castSucc⟩

@[simp] theorem append_state_old {steps : ℕ} (p : FinitePath steps) (s : State)
    (i : Fin (steps + 1)) : (p.append s).state i.castSucc = p.state i := by
  simp [append]

@[simp] theorem append_last {steps : ℕ} (p : FinitePath steps) (s : State) :
    (p.append s).last = s := by simp [append, last]

@[simp] theorem prefix_append {steps : ℕ} (p : FinitePath steps) (s : State) :
    (p.append s).prefixPath = p := by ext i; simp [prefixPath]

@[simp] theorem append_prefix_last {steps : ℕ} (p : FinitePath (steps + 1)) :
    p.prefixPath.append p.last = p := by
  ext i
  refine Fin.lastCases ?_ (fun j ↦ ?_) i
  · simp [append, last]
  · simp [prefixPath]

theorem append_eval_of_le {steps k : ℕ} (p : FinitePath steps) (s : State) (hk : k ≤ steps) :
    (p.append s).eval k = p.eval k := by
  have h1 : min k steps = k := Nat.min_eq_left hk
  have h2 : min k (steps + 1) = k := Nat.min_eq_left (by omega)
  simp only [eval, h1, h2]
  exact append_state_old p s (⟨k, by omega⟩ : Fin (steps + 1))

theorem supported_append_iff {rate : ℝ≥0} {n steps : ℕ} (p : FinitePath steps) (s : State) :
    SupportedPath rate n (steps + 1) (p.append s).eval ↔
      SupportedPath rate n steps p.eval ∧ s ∈ (step rate p.last).support := by
  constructor
  · intro h
    refine ⟨⟨?_, ?_⟩, ?_⟩
    · simpa [append_eval_of_le p s (Nat.zero_le steps)] using h.1
    · intro k hk
      simpa only [append_eval_of_le p s (show k + 1 ≤ steps by omega),
        append_eval_of_le p s (show k ≤ steps by omega)] using h.2 k (by omega)
    · simpa only [eval_last, append_last, append_eval_of_le p s le_rfl] using h.2 steps (by omega)
  · rintro ⟨h, hs⟩
    refine ⟨?_, ?_⟩
    · simpa [append_eval_of_le p s (Nat.zero_le steps)] using h.1
    · intro k hk
      by_cases hks : k < steps
      · simpa only [append_eval_of_le p s (show k + 1 ≤ steps by omega),
          append_eval_of_le p s (show k ≤ steps by omega)] using h.2 k hks
      · have heq : k = steps := by omega
        subst k
        simpa only [eval_last, append_last, append_eval_of_le p s le_rfl] using hs

end FinitePath

/-- Joint law of the finite epidemic history. -/
noncomputable def pathLaw (rate : ℝ≥0) (n : ℕ) : (steps : ℕ) → PMF (FinitePath steps)
  | 0 => PMF.pure ⟨fun _ ↦ initial n⟩
  | steps + 1 => (pathLaw rate n steps).bind fun p ↦ (step rate p.last).map p.append

theorem mem_support_pathLaw_iff {rate : ℝ≥0} {n steps : ℕ} (p : FinitePath steps) :
    p ∈ (pathLaw rate n steps).support ↔ SupportedPath rate n steps p.eval := by
  induction steps with
  | zero =>
      simp only [pathLaw, PMF.mem_support_pure_iff]
      constructor
      · rintro rfl
        exact ⟨rfl, by intro k hk; omega⟩
      · intro h
        ext i
        have hi : i = 0 := Fin.ext (by have := i.isLt; omega)
        simpa [FinitePath.eval, hi] using h.1
  | succ steps ih =>
      rw [← p.append_prefix_last, FinitePath.supported_append_iff]
      constructor
      · intro h
        obtain ⟨q, hq, hmap⟩ := (PMF.mem_support_bind_iff _ _ _).mp h
        obtain ⟨s, hs, heq⟩ := (PMF.mem_support_map_iff _ _ _).mp hmap
        have hqeq := congrArg FinitePath.prefixPath heq
        have hseq := congrArg FinitePath.last heq
        simp only [FinitePath.prefix_append, FinitePath.append_last] at hqeq hseq
        subst q
        subst s
        exact ⟨(ih _).mp hq, hs⟩
      · rintro ⟨h, hs⟩
        apply (PMF.mem_support_bind_iff _ _ _).mpr
        refine ⟨p.prefixPath, (ih _).mpr h, ?_⟩
        exact (PMF.mem_support_map_iff _ _ _).mpr ⟨p.last, hs, rfl⟩

/-- The terminal coordinate of the path law is exactly the evolved state law. -/
theorem pathLaw_map_last (rate : ℝ≥0) (n steps : ℕ) :
    (pathLaw rate n steps).map FinitePath.last = evolve rate n steps := by
  induction steps with
  | zero => rw [pathLaw, PMF.pure_map]; rfl
  | succ steps ih =>
      rw [pathLaw, PMF.map_bind]
      simp_rw [PMF.map_comp]
      have hf (p : FinitePath steps) : FinitePath.last ∘ p.append = id := by
        funext s
        simp
      simp_rw [hf, PMF.map_id]
      change (pathLaw rate n steps).bind (step rate ∘ FinitePath.last) = _
      rw [← PMF.bind_map, ih]
      rfl

/-- The whole prefix has exactly the earlier path law. -/
theorem pathLaw_map_prefix (rate : ℝ≥0) (n steps : ℕ) :
    (pathLaw rate n (steps + 1)).map FinitePath.prefixPath = pathLaw rate n steps := by
  rw [pathLaw, PMF.map_bind]
  simp_rw [PMF.map_comp]
  have hf (p : FinitePath steps) : FinitePath.prefixPath ∘ p.append = Function.const State p := by
    funext s
    simp
  simp_rw [hf, PMF.map_const]
  exact PMF.bind_pure _

/-- Every coordinate marginal has its correct epidemic state distribution. -/
theorem pathLaw_map_at (rate : ℝ≥0) (n steps k : ℕ) (hk : k ≤ steps) :
    (pathLaw rate n steps).map (fun p ↦ p.eval k) = evolve rate n k := by
  induction steps with
  | zero =>
      have heq : k = 0 := by omega
      subst k
      simpa only [FinitePath.eval_last] using pathLaw_map_last rate n 0
  | succ steps ih =>
      by_cases hks : k ≤ steps
      · rw [pathLaw, PMF.map_bind]
        simp_rw [PMF.map_comp]
        have hf (p : FinitePath steps) : (fun q : FinitePath (steps + 1) ↦ q.eval k) ∘ p.append =
            Function.const State (p.eval k) := by
          funext s
          exact p.append_eval_of_le s hks
        simp_rw [hf, PMF.map_const]
        exact ih hks
      · have heq : k = steps + 1 := by omega
        subst k
        simpa only [FinitePath.eval_last] using pathLaw_map_last rate n (steps + 1)

/-- Probability measure on all the states of the finite history. -/
noncomputable def pathMeasure (rate : ℝ≥0) (n steps : ℕ) : Measure (FinitePath steps) :=
  (pathLaw rate n steps).toMeasure

instance (rate : ℝ≥0) (n steps : ℕ) : IsProbabilityMeasure (pathMeasure rate n steps) := by
  unfold pathMeasure
  infer_instance

theorem pathMeasure_map_at (rate : ℝ≥0) (n steps k : ℕ) (hk : k ≤ steps) :
    (pathMeasure rate n steps).map (fun p ↦ p.eval k) = (evolve rate n k).toMeasure := by
  rw [pathMeasure, PMF.toMeasure_map _ _ (FinitePath.measurable _), pathLaw_map_at rate n steps k hk]

/-- Every history is supported almost surely, rather than being an extra
hypothesis on the stochastic model. -/
theorem ae_supportedPath (rate : ℝ≥0) (n steps : ℕ) :
    ∀ᵐ p ∂pathMeasure rate n steps, SupportedPath rate n steps p.eval := by
  apply (ae_iff_prob_eq_one (FinitePath.measurable _)).mpr
  exact (PMF.toMeasure_apply_eq_one_iff _ (by trivial)).mpr
    (fun p hp ↦ (mem_support_pathLaw_iff p).mp hp)

end HeightPaper.Model
