module

public import Mathlib.MeasureTheory.Constructions.Polish.Basic
public import Mathlib.MeasureTheory.Function.FactorsThrough

/-!
# Measurability through a complete count word

A measurable observable on a standard Borel sample space that is constant
on the fibers of a count-word map is measurable for the sigma algebra
generated by that word. This supplies the infinite-word analogue of the
finite-code lemma used for finite epidemic histories.
-/

@[expose] public section

open MeasureTheory MeasurableSpace Set

namespace HeightPaper.CountCoupling

theorem measurable_comap_of_factorsThrough_standardBorel
    {X Y Z : Type*} [MeasurableSpace X] [StandardBorelSpace X]
    [MeasurableSpace Y] [CountablySeparated Y] [MeasurableSpace Z]
    (f : X → Y) (g : X → Z) (hf : Measurable f) (hg : Measurable g)
    (hfactor : g.FactorsThrough f) :
    Measurable[(inferInstance : MeasurableSpace Y).comap f] g := by
  classical
  let f' : X → range f := rangeFactorization f
  let G : range f → Z := fun y ↦ g (Classical.choose y.property)
  have hf' : Measurable f' := Measurable.subtype_mk hf
  have heq : g = G ∘ f' := by
    funext x
    exact hfactor
      (Classical.choose_spec (show ∃ x', f x' = f x from ⟨x, rfl⟩)).symm
  haveI : CountablySeparated (range f) := Subtype.countablySeparated
  have hG : Measurable G :=
    (hf'.measurable_comp_iff_of_surjective rangeFactorization_surjective).mp
      (by simpa only [← heq] using hg)
  have hfc : Measurable[(inferInstance : MeasurableSpace Y).comap f] f' :=
    Measurable.subtype_mk (comap_measurable f)
  rw [heq]
  exact hG.comp hfc

end HeightPaper.CountCoupling
