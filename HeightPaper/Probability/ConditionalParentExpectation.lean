module

public import HeightPaper.Probability.ConditionalMomentTransfer
public import Mathlib.MeasureTheory.Function.ConditionalExpectation.Basic

/-!
# Conditional expectation on an independent product space

The parent-uniform integral is a version of conditional expectation given the
event-word coordinate.  This bridge is needed to state the finite coupled
profile results with the paper's conditional-expectation notation.
-/

@[expose] public section

open MeasureTheory Set
open scoped NNReal

namespace MeasureTheory.Measure

variable {Ω Ξ : Type*} [MeasurableSpace Ω] [MeasurableSpace Ξ]

/-- For independent coordinates, conditioning an integrable real observable
on the first coordinate is integration over the second coordinate. -/
theorem condExp_fst_prod_ae_eq_integral (μ : Measure Ω) (ν : Measure Ξ)
    [IsProbabilityMeasure μ] [IsProbabilityMeasure ν]
    (f : Ω × Ξ → ℝ) (hfmeas : Measurable f)
    (hf : Integrable f (μ.prod ν)) :
    (fun q : Ω × Ξ ↦ ∫ v, f (q.1, v) ∂ν) =ᵐ[μ.prod ν]
      (μ.prod ν)[f | (inferInstance : MeasurableSpace Ω).comap Prod.fst] := by
  let g : Ω → ℝ := fun u ↦ ∫ v, f (u, v) ∂ν
  have hg : Integrable g μ := hf.integral_prod_left
  apply ae_eq_condExp_of_forall_setIntegral_eq measurable_fst.comap_le hf
  · intro s _ _
    exact (hg.comp_fst ν).integrableOn
  · intro s hs _
    obtain ⟨t, ht, rfl⟩ := hs
    have hset : Prod.fst ⁻¹' t = t ×ˢ (Set.univ : Set Ξ) := by
      ext q
      simp
    rw [hset]
    rw [setIntegral_prod (fun q : Ω × Ξ ↦ g q.1)
      (hg.comp_fst ν).restrict,
      setIntegral_prod f hf.restrict]
    simp [g]
  · have hgm : StronglyMeasurable g :=
      hfmeas.stronglyMeasurable.integral_prod_right'
    exact (hgm.comp_measurable (comap_measurable Prod.fst)).aestronglyMeasurable

end MeasureTheory.Measure

namespace HeightPaper.CountCoupling

/-- A real observable determined by a finite code is strongly measurable for
the sigma-algebra generated by that code. -/
theorem stronglyMeasurable_comap_of_finite_code
    {Ω C : Type*} [MeasurableSpace C] [MeasurableSingletonClass C] [Finite C]
    (code : Ω → C) (g : Ω → ℝ)
    (hcongr : ∀ x y, code x = code y → g x = g y) :
    StronglyMeasurable[(inferInstance : MeasurableSpace C).comap code] g := by
  classical
  let G : C → ℝ := fun c ↦
    if h : ∃ x, code x = c then g (Classical.choose h) else 0
  have hfactor (x : Ω) : g x = G (code x) := by
    dsimp [G]
    rw [dite_eq_left ⟨x, rfl⟩]
    exact hcongr x _
      (Classical.choose_spec (show ∃ y, code y = code x from ⟨x, rfl⟩)).symm
  have hG : StronglyMeasurable G := (measurable_of_countable G).stronglyMeasurable
  have heq : g = G ∘ code := funext hfactor
  rw [heq]
  exact hG.comp_measurable (comap_measurable code)

/-- A measurable observable determined by a finite code is integrable under
any finite measure, irrespective of the size of the original sample space. -/
theorem integrable_of_finite_code
    {Ω C : Type*} [MeasurableSpace Ω] [MeasurableSpace C]
    [MeasurableSingletonClass C] [Finite C]
    (μ : Measure Ω) [IsFiniteMeasure μ]
    (code : Ω → C) (hcode : Measurable code)
    (g : Ω → ℝ)
    (hcongr : ∀ x y, code x = code y → g x = g y) :
    Integrable g μ := by
  classical
  let G : C → ℝ := fun c ↦
    if h : ∃ x, code x = c then g (Classical.choose h) else 0
  have hfactor (x : Ω) : g x = G (code x) := by
    dsimp [G]
    rw [dite_eq_left ⟨x, rfl⟩]
    exact hcongr x _ (Classical.choose_spec (show ∃ y, code y = code x from ⟨x, rfl⟩)).symm
  have hmeas : Measurable g := by
    have hG : Measurable G := measurable_of_countable G
    have heq : g = G ∘ code := funext hfactor
    rw [heq]
    exact hG.comp hcode
  have hfin : (Set.range g).Finite := by
    apply (Set.finite_univ.image G).subset
    rintro y ⟨x, rfl⟩
    exact ⟨code x, Set.mem_univ _, (hfactor x).symm⟩
  obtain ⟨M, hM⟩ := isBounded_iff_forall_norm_le.mp hfin.isBounded
  exact Integrable.of_bound hmeas.aestronglyMeasurable M
    (ae_of_all _ fun x ↦ hM (g x) ⟨x, rfl⟩)

end HeightPaper.CountCoupling
